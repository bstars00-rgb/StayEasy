# StayEasy frontend environment variables (Vite). Copy to .env.local.

# Base origin of the StayEasy backend (built by Codex). The client appends the
# /api/v1 prefix automatically (see docs/BACKEND_API_SPEC.md).
# Leave EMPTY to keep the app fully on localStorage (offline demo).
# When set, the app routes data operations through the API (USE_API = true).
VITE_API_BASE_URL=

# Path prefix. Spec uses /api/v1 (default). The current backend prototype
# serves at root — set this to empty to target it: VITE_API_PREFIX=
VITE_API_PREFIX=/api/v1

# Google OAuth Client ID. If set, real Google Identity Services is used for
# sign-in; otherwise a frontend-only demo sign-in is used.
VITE_GOOGLE_CLIENT_ID=
