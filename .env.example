# StayEasy frontend environment variables (Vite). Copy to .env.local.

# Base URL of the StayEasy backend API (built separately — see AGENTS.md).
# Leave empty to keep the app fully on localStorage (offline demo).
VITE_API_BASE_URL=

# Set to "true" to route data operations through the API instead of localStorage.
VITE_USE_API=false

# Google OAuth Client ID. If set, real Google Identity Services is used for
# sign-in; otherwise a frontend-only demo sign-in is used.
VITE_GOOGLE_CLIENT_ID=
